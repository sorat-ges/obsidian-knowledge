---
const { entry } = Astro.locals.starlightRoute;
const {
  title,
  capability,
  services = [],
  integrations = [],
  aliases = [],
  errorCodes = [],
  status = "active",
  lastUpdated,
} = entry.data;
const updatedOn =
  lastUpdated instanceof Date
    ? lastUpdated.toISOString().slice(0, 10)
    : typeof lastUpdated === "string"
      ? lastUpdated.slice(0, 10)
      : undefined;
---

<script>
  import { isRecentlyUpdated } from "../utils/document-updates";

  function updateRecentFeatureHighlights() {
    document
      .querySelectorAll<HTMLElement>("mark.changed-feature[data-updated-on]")
      .forEach((element) => {
        element.classList.toggle(
          "is-recent",
          isRecentlyUpdated(element.dataset.updatedOn),
        );
      });
  }

  updateRecentFeatureHighlights();
  document.addEventListener("astro:page-load", updateRecentFeatureHighlights);
</script>

<h1 id="_top" data-pagefind-weight="10">{title}</h1>

<dl class="flow-metadata" aria-label="Document metadata">
  {
    capability && (
      <div class="metadata-group">
        <dt>Capability</dt>
        <dd data-pagefind-filter="capability" data-pagefind-meta="capability">
          {capability}
        </dd>
      </div>
    )
  }
  {
    services.length > 0 && (
      <div class="metadata-group">
        <dt>Services</dt>
        <dd>
          {services.map((service) => (
            <span data-pagefind-filter="service" data-pagefind-meta="service">
              {service}
            </span>
          ))}
        </dd>
      </div>
    )
  }
  {
    integrations.length > 0 && (
      <div class="metadata-group">
        <dt>Integrations</dt>
        <dd>
          {integrations.map((integration) => (
            <span
              data-pagefind-filter="integration"
              data-pagefind-meta="integration"
            >
              {integration}
            </span>
          ))}
        </dd>
      </div>
    )
  }
  {
    aliases.length > 0 && (
      <div class="metadata-group search-aliases">
        <dt>คำค้น</dt>
        <dd data-pagefind-weight="10" data-pagefind-meta="alias">
          <details class="search-alias-disclosure">
            <summary
              aria-label={`แสดงหรือซ่อนคำค้นทั้งหมด ${aliases.length} รายการ`}
              data-count={aliases.length}
            ></summary>
            <div class="search-alias-list">{aliases.join(", ")}</div>
          </details>
        </dd>
      </div>
    )
  }
  {
    errorCodes.length > 0 && (
      <div class="metadata-group search-error-codes">
        <dt>Error codes</dt>
        <dd>
          {errorCodes.map((errorCode) => (
            <span
              data-pagefind-filter="errorCode"
              data-pagefind-meta="errorCode"
            >
              {errorCode}
            </span>
          ))}
        </dd>
      </div>
    )
  }
  <div class="metadata-group">
    <dt>Status</dt>
    <dd
      class={`status status-${status}`}
      data-pagefind-filter="status"
      data-pagefind-meta="status"
    >
      {status}
    </dd>
  </div>
  {
    updatedOn && (
      <div class="metadata-group">
        <dt>อัปเดตล่าสุด</dt>
        <dd>
          <time datetime={`${updatedOn}T00:00:00Z`}>{updatedOn}</time>
        </dd>
      </div>
    )
  }
</dl>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
